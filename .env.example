# Copy to .env (git-ignored), chmod 600 .env, or export in your shell. Never commit real values.
# In production, inject these from a secrets manager instead of a file.

# Airwallex sandbox credentials: Account > Developer > API keys
AWX_CLIENT_ID=
AWX_API_KEY=
# AWX_BASE_URL=https://api.sandbox.airwallex.com
# Optional; sent on non-FX calls only (never on /fx/*)
# AWX_API_VERSION=

# Audit database key (required outside mock mode). Create with: python manage.py gen-key
# Keep it in a secrets manager, NOT next to state/treasury.db: whoever holds both could rewrite history.
TREASURY_AUDIT_KEY=

# Append each run's audit head (seq + hash) here; point it at storage the DB owner cannot rewrite.
# TREASURY_ANCHOR_FILE=/mnt/worm/treasury-anchors.jsonl

# Who runs the agent (requests approvals; may never approve them). Defaults to the OS user.
# TREASURY_OPERATOR=ops.runner

# Counterparty screening list (JSON). 'off' is refused outside mock mode unless
# TREASURY_ALLOW_NO_SCREENING=1, and is then recorded in the audit log.
# TREASURY_SCREENING_LIST=./fixtures/screening_list.json

# Unattended --yes runs against the SANDBOX only (refused against production). Approvers otherwise
# sign in at the terminal with their own id and PIN.
# TREASURY_APPROVER_ID=
# TREASURY_APPROVER_PIN=

# Model for reading the customer email and explaining exceptions (optional).
# Without a key the deterministic reader and template notes are used. Email text is sent to the
# provider: have a data processing agreement in place, or use LLM_PROVIDER=rules.
# LLM_PROVIDER=auto            # auto | anthropic | openai | rules
# ANTHROPIC_API_KEY=
# LLM_MODEL=claude-haiku-5-5
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1   # https only (http allowed to localhost)

# Demo behaviour
# TREASURY_APPLY_CASH_CAP=1     # plan within the scenario's operating cash (sandbox wallets are pre-funded)
# TREASURY_STATE_DIR=./state
# TREASURY_REPO_URL=https://github.com/<you>/treasury-controller
# TREASURY_REFERENCE_SUFFIX=-r2  # re-run the live demo: the same invoice reference is never paid twice
